# Anthropic — used by /api/compile-text
ANTHROPIC_API_KEY=sk-ant-...
COMPILE_MODEL=claude-opus-5

# Modal endpoints (server-side only; never expose to the browser)
MODAL_COMPILE_URL=https://<workspace>--nla-steering-compile-web.modal.run
MODAL_STEER_URL=https://<workspace>--nla-steering-steer-web.modal.run
DEMO_KEY=<same value as the Modal demo-key secret>

# Upstash Redis (rate limiting). Omit both to disable limiting in local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Flip to "1" once the Modal side is deployed
NEXT_PUBLIC_LIVE_ENABLED=0
